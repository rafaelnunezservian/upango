{
  "name": "upango",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "react-router build && npm run build:embed",
    "build:embed": "node packages/selector-carrito/build.mjs",
    "dev": "node scripts/dev.mjs",
    "build:embed:watch": "node packages/selector-carrito/build.mjs --watch",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "tsx deploy/src/cli.ts",
    "deploy:shopify": "npm run build:embed && shopify app deploy --config shopify.app.toml",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage": "^7.0.0",
    "@shopify/shopify-app-session-storage-memory": "^8.0.0",
    "@puntos-recogida/contratos": "*",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^3.25.76",
    "@shopify/cli": "3.93.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.36.0",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "packages/*",
    "extensions/*",
    "deploy"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "author": "isaac",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.27.4": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
