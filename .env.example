# Variables de entorno del backend (CT-09). Copiar a .env para desarrollo local.
# Ninguna variable de este archivo tiene un valor secreto real.

# --- Obligatorias ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_delivery_customizations,write_app_proxy

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Sesiones (SessionStorage) ---
# "memoria" en desarrollo, "firestore" en producción.
SESSION_STORAGE_DRIVER=memoria
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLECCION_SESIONES=shopify_sessions
FIRESTORE_EMULATOR_HOST=

# --- Caché de puntos de recogida ---
PUNTOS_CACHE_TTL_SEGUNDOS=300
PUNTOS_CACHE_STALE_MAX_SEGUNDOS=86400
PUNTOS_TAMANO_PAGINA=250

# --- Observabilidad ---
LOG_LEVEL=info

# --- Herramientas de desarrollo ---
# Habilita "Crear puntos de ejemplo" en la página de admin (FR-005).
# El arranque DEBE fallar si está en "true" con NODE_ENV=production.
HABILITAR_SEMILLA=false

# --- Heredada del template ---
SHOP_CUSTOM_DOMAIN=
